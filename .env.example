# Copy to .env and adjust. docker compose reads .env automatically.

# --- Monitoring exposure ---
#
# Prometheus (9090) and Grafana (3001) are published on these two host
# addresses only. Everything else in the monitoring stack — node_exporter, the
# gateway's own /metrics, the web proxy's /metrics — is reachable solely from
# inside the compose network and is never published to the host.
#
# Leave MONITORING_BIND_LOCAL as loopback. Set MONITORING_BIND_TAILSCALE to this
# host's Tailscale address (`tailscale ip -4`).
#
# If you do not use Tailscale, set MONITORING_BIND_TAILSCALE to 127.0.0.1 as
# well — Docker collapses the resulting duplicate binding. Do NOT set it to
# 0.0.0.0 or leave it empty: either publishes Grafana and an unauthenticated
# Prometheus to the internet.
MONITORING_BIND_LOCAL=127.0.0.1
MONITORING_BIND_TAILSCALE=127.0.0.1

# --- Grafana admin ---
#
# Change the password before first start. Grafana persists the admin password
# in its own database on first run, so editing this afterwards has no effect —
# use the UI, or delete the grafana-data volume to re-seed.
#
# This matters more than it used to: Grafana is now reachable from the internet
# through nginx at mon.pcpursuit.net, not only from loopback and Tailscale.
# Cloudflare Access is the outer gate, this login is the inner one.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Grafana public URL ---
#
# Grafana builds absolute URLs -- share links, snapshots, alert links -- from
# root_url, NOT from the incoming Host header, so this has to match the mon.*
# server_name in nginx/nginx.conf. There is no shared source for the two:
# nginx does not expand environment variables in its config.
GRAFANA_ROOT_URL=https://mon.pcpursuit.net
GRAFANA_DOMAIN=mon.pcpursuit.net

# --- BBS boards ---
#
# The instances/ directory of the ENiGMA1/2 compose project, bind-mounted
# read-only into monitoring/bbs-exporter. Every subdirectory holding a db/ is
# discovered as a board, so adding a fourth needs no change here.
#
# Use an absolute path or ${HOME}; Compose does NOT expand "~" in a volume
# source -- it creates a directory literally named "~" and mounts that, and the
# exporter then comes up healthy reporting zero instances.
BBS_INSTANCES_DIR=${HOME}/bbs/bbs_infra/instances
