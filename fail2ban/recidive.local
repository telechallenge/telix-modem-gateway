# Escalating bans for repeat offenders
# Monitors fail2ban's own log to detect IPs that get banned repeatedly

[recidive]
enabled = true
logpath = /data/log/fail2ban.log
bantime = 604800
findtime = 86400
# 50 bans inside findtime (a day) before the week-long ban lands. Well up from
# the stock 3, because the telix jail's 15-minute bantime lets an IP cycle back
# in up to 96 times a day — at 3 this jail would fire on someone merely
# persistent rather than on someone genuinely hostile.
maxretry = 50
